{
  "name": "dsh-slot-health",
  "version": "1.0.2",
  "description": "Live health pane for local LLM endpoints (llama.cpp slots + Ollama models) in the DeepSeek Harness web UI.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "media"
  ],
  "scripts": {
    "build": "node build.mjs && tsc --noEmit",
    "prepare": "node build.mjs || node -e \"console.warn('[dsh-slot-health] prepare: build skipped (build toolchain unavailable); relying on prebuilt lib/')\"",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janpauldahlke/dsh-slot-health.git"
  },
  "homepage": "https://github.com/janpauldahlke/dsh-slot-health#readme",
  "bugs": {
    "url": "https://github.com/janpauldahlke/dsh-slot-health/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh",
    "cordis",
    "cordis-plugin",
    "llama.cpp",
    "llamacpp",
    "ollama",
    "slot",
    "endpoint-health",
    "local-llm",
    "sidebar",
    "web-ui"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "peerDependencies": {
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "esbuild": "^0.27.0",
    "react": "^19.2.7",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "author": {
    "name": "Jan (HagbardCeline)",
    "email": "jandareal@gmail.com"
  },
  "contributors": [
    {
      "name": "Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-MTP-GGUF (coauthor)"
    }
  ],
  "license": "MIT"
}
